# 方寸服务端基础配置
HOST=127.0.0.1
PORT=18443
DATA_DIR=/var/lib/fangcun
TRUST_PROXY=true
COOKIE_SECURE=true

# Outlook / Microsoft Graph 双向同步
MICROSOFT_CLIENT_ID=replace-with-entra-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-client-secret-value
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://schedule.woxingsf.top/api/integrations/outlook/callback

# Google Calendar API 双向同步
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
GOOGLE_REDIRECT_URI=https://schedule.woxingsf.top/api/integrations/google/callback

# 两个集成共用的服务端令牌加密密钥；部署后不要更换
FANGCUN_INTEGRATION_KEY=replace-with-at-least-32-random-characters


# 应用商店公开信息；正式上架前必须与开发者账号、ICP 与 APP 备案主体一致
FANGCUN_OPERATOR_NAME=replace-with-registered-operator-name
FANGCUN_CONTACT=replace-with-public-contact
FANGCUN_APP_BEIAN=replace-with-app-filing-number
FANGCUN_ICP_BEIAN=replace-with-icp-filing-number
# 只有上述信息已真实配置时才设为 true；verify.sh 会执行上架前检查
FANGCUN_STORE_RELEASE=false
